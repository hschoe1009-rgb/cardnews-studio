# 카드뉴스 스튜디오 설정 예시
# 이 파일을 .env 로 복사해 쓰거나, 앱 설정 화면에서 키를 넣으세요.
# 키를 설정 화면에서 넣으면 그 사람의 브라우저에만 저장되고 이 파일은 필요 없습니다.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

CLAUDE_MODEL=claude-opus-5
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_MODE=api

# true 면 공용 키를 무시하고 각 사용자가 본인 키를 넣어야만 동작합니다.
REQUIRE_USER_KEY=false

# 전략 근거로 함께 읽을 폴더 (JSON 배열). 없으면 playbook.md 만 사용합니다.
OBSIDIAN_STRATEGY_DIRS=[]
